# ==============================================================================
# CSaaS Platform - Environment Configuration
# ------------------------------------------------------------------------------
# HOW TO USE:
#   1. cp .env.example .env
#   2. Paste your real values into .env  (NEVER commit .env - it is gitignored)
#   3. Anything you do not have yet: leave blank. The app boots with degraded
#      features and logs exactly which provider is disabled and why.
#
# LEGEND:
#   [P0] required for Phase 0-1 (boot + first SMS)
#   [P1] required for voice phases
#   [P2] required for AI phases
#   [--] optional / later
#
# 8.13: this file is split into two parts. PART 1 is read at boot by
# backend/app/config.py's `Settings` (pydantic-settings, case-insensitive env vars) -
# setting one of these changes real app behaviour. PART 2 is everything that drifted in
# over time without ever being wired into `Settings`: some of it is genuinely per-org
# runtime config (dialer/SMS/compliance policy lives in the DB, edited via the API -
# see docs/RUNBOOK.md's "Carrier failover" section for one example), some is read by
# something other than the Python app (deploy tooling, the frontend dev server), and
# some is simply reserved for a phase that has not landed yet. Setting a PART 2 var in
# .env today has NO EFFECT on the running api container. Names were verified against
# `backend/app/config.py` directly - grep it for `class Settings` if this drifts again.
# ==============================================================================


# ##############################################################################
# PART 1 - READ BY THE APP (backend/app/config.py Settings)
# ##############################################################################

# ==============================================================================
# CORE APP                                                                  [P0]
# ==============================================================================
APP_ENV=development                       # development | staging | production
APP_NAME=csaas
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
API_PORT=8080

# Public base URL of THIS server - carriers POST webhooks here.
# Local dev: use an ngrok/cloudflared tunnel. Prod: https://api.yourdomain.com
PUBLIC_BASE_URL=https://your-tunnel-or-domain.example.com

# Public base URL of the frontend console (CORS allow-list, invite links)
PUBLIC_WEB_URL=http://localhost:5173

# Comma-separated origins allowed to hit the API from a browser
CORS_ORIGINS=http://localhost:5173

# Secrets - generate with:  openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
JWT_EXPIRE_HOURS=24

# Fernet key used to encrypt provider credentials at rest in the DB. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# P17: encrypts per-org provider_accounts.credentials_encrypted (Fernet key, same
# generator command as above). A SEPARATE secret from CREDENTIAL_ENCRYPTION_KEY on
# purpose - rotating one must never silently rotate the other. Required in production.
CREDENTIALS_MASTER_KEY=

# TEST/DEV ONLY. Registration is invite-only in production and boot REFUSES this flag
# when APP_ENV=production - it cannot be the reason a live instance is open.
ALLOW_OPEN_REGISTRATION=false

# Shared secret for platform-operator registration status callbacks (10DLC/TFV
# approve/reject). Empty means those routes answer 503 - set a long random secret
# in prod. Generate: openssl rand -hex 32
PLATFORM_OPS_TOKEN=

# Sliding-window request rate limiting (per IP + per caller-supplied identifier).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20                # requests allowed per window
RATE_LIMIT_WINDOW_SECONDS=60


# ==============================================================================
# DATASTORES                                                                [P0]
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://csaas:csaas@localhost:5433/csaas
# Sync URL used by Alembic migrations (same DB, different driver)
DATABASE_URL_SYNC=postgresql://csaas:csaas@localhost:5433/csaas
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# The app reads REDIS_URL only - if CSAAS_REDIS_PASSWORD below is set, this MUST embed
# it (redis://:PASSWORD@host:port/db) or the app cannot authenticate.
REDIS_URL=redis://localhost:6379/0

# 8.7: deploy/docker-compose.prod.yml's redis service reads THIS var directly (not
# REDIS_URL) to enable `--requirepass`. Leave blank to keep today's passwordless
# behaviour (backward-compatible; compose falls back automatically). Once you set it
# here, you must ALSO update REDIS_URL above to include it, and paste the same value
# into deploy/livekit/sip.yaml's `redis:` block on the box (that file is a literal
# mount, not env-templated - see the comment already in that file). Generate:
#   openssl rand -hex 24
CSAAS_REDIS_PASSWORD=

# Object storage for MMS media, call recordings, voicemail, transcripts.
# Works with AWS S3, Cloudflare R2, Backblaze B2, or self-hosted MinIO.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=csaas-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ==============================================================================
# PROVIDER: BANDWIDTH  -  PRIMARY CARRIER                                   [P0]
# ------------------------------------------------------------------------------
# Where to find these:
#   Account ID .............. Bandwidth Dashboard, top-right / URL
#   API user/pass ........... Dashboard > Account > Users (API credentials)
#   Application IDs ......... Dashboard > Applications (one for Messaging,
#                             one for Voice). Each app holds the callback URL.
#   Site (sub-account) ID ... Dashboard > Networks > Sites
# ==============================================================================
BANDWIDTH_ENABLED=true
BANDWIDTH_ACCOUNT_ID=
BANDWIDTH_API_USERNAME=
BANDWIDTH_API_PASSWORD=

# "oauth2" for a dashboard Client ID / Client Secret (current Bandwidth model),
# "basic" for a legacy API-user username/password pair (the two vars above).
BANDWIDTH_AUTH_MODE=oauth2

# Messaging (SMS/MMS)
BANDWIDTH_MESSAGING_APPLICATION_ID=

# Voice
BANDWIDTH_VOICE_APPLICATION_ID=

# Site (sub-account) id, used for number orders. Optional.
BANDWIDTH_SITE_ID=

# Inbound webhook auth - set the SAME basic-auth pair on the Bandwidth
# Application callback config. We reject any callback that does not match.
BANDWIDTH_WEBHOOK_USERNAME=
BANDWIDTH_WEBHOOK_PASSWORD=

# Default sending number in E.164 (e.g. +12145551234)
BANDWIDTH_DEFAULT_NUMBER=


# ==============================================================================
# PROVIDER: TELNYX  -  BACKUP / FAILOVER CARRIER                            [P1]
# ------------------------------------------------------------------------------
#   API key ............ portal.telnyx.com > API Keys  (starts KEY...)
#   Public key ......... same page - verifies webhook ed25519 signatures
#   Messaging profile .. Messaging > Messaging Profiles
#   Voice connection ... Voice > Call Control Applications (connection_id)
# ==============================================================================
TELNYX_ENABLED=false
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_VOICE_CONNECTION_ID=
TELNYX_DEFAULT_NUMBER=


# ==============================================================================
# PROVIDER: TWILIO                                                         [--]
# ------------------------------------------------------------------------------
#   Account SID (starts "AC") .. Console > Account Info
#   Auth token .................. same page
#   Messaging Service SID ....... optional ("MG..."); when set, Twilio picks the sender
#   Webhook URL .................. the EXACT public URL registered with Twilio - the
#                                  signature covers it and it must never be rebuilt from
#                                  an attacker-controllable Host header.
# ==============================================================================
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_URL=
TWILIO_DEFAULT_NUMBER=


# ==============================================================================
# PROVIDER: PLIVO                                                          [--]
# ------------------------------------------------------------------------------
#   Auth ID / Auth token ........ Plivo Console > Account
#   Powerpack UUID ............... optional, for pooled sending
#   Webhook URL ................... the registered URL; the V3 signature covers it
#                                    (same reasoning as Twilio above).
# ==============================================================================
PLIVO_ENABLED=false
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_POWERPACK_UUID=
PLIVO_WEBHOOK_URL=
PLIVO_DEFAULT_NUMBER=


# ==============================================================================
# PROVIDER: SIGNALWIRE  -  THIRD CARRIER                                   [P3b]
# ------------------------------------------------------------------------------
#   Written against the Twilio-COMPATIBLE (LaML) API, so the same adapter serves
#   Twilio by changing SIGNALWIRE_SPACE_URL.
#   Project ID ......... your SignalWire space > API
#   API token .......... same page (starts PT...)
#   Space URL .......... e.g. yourspace.signalwire.com
#   Webhook URL ........ the EXACT public URL you registered with SignalWire.
#                        Twilio-style signatures cover the URL, and it must not be
#                        rebuilt from the request Host header - that is caller-
#                        controlled, and a verifier the caller can steer is no
#                        verifier at all.
# ==============================================================================
SIGNALWIRE_ENABLED=false
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_WEBHOOK_URL=
SIGNALWIRE_DEFAULT_NUMBER=

# DEV/DEMO ONLY. A fake carrier that drives the REAL ingestion pipeline (DLRs + an echo
# inbound reply) so the console is demonstrable with no carrier account. Boot REFUSES it
# when APP_ENV=production, or when BANDWIDTH_ENABLED is also true (ambiguous carrier).
LOOPBACK_CARRIER_ENABLED=false

# Refuse to send from a number we hold no registration for. Off by default because a
# number registered directly at the carrier is perfectly legitimate. This flag can only
# make enforcement STRICTER - there is no flag that loosens it.
REQUIRE_NUMBER_REGISTRATION=false

# Preferred carrier when an org has more than one DB-backed provider account active
# and none is explicitly named. Empty = first configured (bandwidth/telnyx/... order).
PRIMARY_PROVIDER=

# Accept a manually-added number even when its carrier cannot verify ownership of it
# (API unreachable, or no ownership-lookup support). Off by default - fail closed.
ALLOW_UNVERIFIED_NUMBER_ADD=false


# ==============================================================================
# LIVEKIT MEDIA PLANE  (P6/P7, decision D17)                                [P1]
# ------------------------------------------------------------------------------
# Self-hosted SFU + SIP bridge; see deploy/livekit/. Key id is fixed: csaas-media.
# ==============================================================================
LIVEKIT_URL=ws://127.0.0.1:7880
# Public URL the browser softphone connects to (behind nginx TLS); falls back to
# LIVEKIT_URL if blank.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=csaas-media
# Generate: openssl rand -hex 32
LIVEKIT_API_SECRET=
# From `lk sip outbound create` after the Telnyx trunk exists (deploy/livekit/README.md)
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=


# ==============================================================================
# LLM PROVIDERS  (AI conversation brain for SMS + voice) - API keys only   [P2]
# ==============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=


# ==============================================================================
# STT  -  SPEECH TO TEXT (streaming, 8kHz mulaw telephony audio)            [P2]
# ==============================================================================
STT_PROVIDER=deepgram                     # deepgram | assemblyai | azure | local
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=


# ==============================================================================
# TTS  -  TEXT TO SPEECH (streaming, low time-to-first-byte)                [P2]
# ==============================================================================
TTS_PROVIDER=elevenlabs                   # elevenlabs | cartesia | deepgram | azure | local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=


# ==============================================================================
# MEDIA STORAGE & SWEEPER  (MMS media, recordings, voicemail, transcripts)  [P1]
# ==============================================================================
MEDIA_STORE_BACKEND=local                 # local | memory | s3 (s3 raises until P5)
# Relative to the api container's /app - matches the csaas_media volume mount in
# deploy/docker-compose.prod.yml (8.1). Do not change without also updating that mount.
MEDIA_LOCAL_ROOT=var/media
MEDIA_RETENTION_DAYS=0                    # 0 = never expire
SWEEPER_ENABLED=true
SWEEPER_INTERVAL_SECONDS=60


# ==============================================================================
# OPS  -  error tracking + outbound email                                  [--]
# ==============================================================================
SENTRY_DSN=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=


# ##############################################################################
# PART 2 - NOT WIRED / PER-ORG DB SETTING (INERT)
# ------------------------------------------------------------------------------
# Nothing below is read by backend/app/config.py's Settings. Some of it is real,
# LIVE policy that just lives in the database instead of env (dialer/SMS/compliance -
# see the /api/v1/routing/policy example in docs/RUNBOOK.md); some is read by
# something other than the api container (the frontend dev server, deploy.sh's own
# CLI args); the rest is reserved for a phase that has not shipped yet. Setting any of
# these in .env today changes nothing about the running app - do not spend time
# debugging "why didn't this take effect" here without first checking config.py.
# ##############################################################################

# Frontend dev server port (Vite) - not read by the Python app.
WEB_PORT=5173

# Reserved / not yet consumed by Settings.
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_QUEUE_URL=redis://localhost:6379/2
S3_PUBLIC_BASE_URL=                       # CDN/public URL if bucket is fronted
S3_FORCE_PATH_STYLE=true                  # true for MinIO/R2, false for AWS S3

# Bandwidth extras not read by Settings today (BANDWIDTH_SITE_ID above is the field
# the app actually reads for the Site/sub-account id - BANDWIDTH_SUBACCOUNT_ID below is
# the old name and is inert).
BANDWIDTH_MESSAGING_BASE_URL=https://messaging.bandwidth.com/api/v2
BANDWIDTH_VOICE_BASE_URL=https://voice.bandwidth.com/api/v2
BANDWIDTH_DASHBOARD_BASE_URL=https://dashboard.bandwidth.com/api
BANDWIDTH_DASHBOARD_USERNAME=
BANDWIDTH_DASHBOARD_PASSWORD=
BANDWIDTH_SUBACCOUNT_ID=                  # superseded by BANDWIDTH_SITE_ID (Part 1)
BANDWIDTH_LOCATION_ID=                    # "SIP Peer" ID

# Telnyx extras not read by Settings today.
TELNYX_VOICE_APP_ID=
TELNYX_SIP_CONNECTION_ID=
TELNYX_BASE_URL=https://api.telnyx.com/v2

# Failover policy - actually configured per-org via PATCH /api/v1/routing/policy
# (docs/RUNBOOK.md, "Carrier failover: manual override & breaker interpretation").
CARRIER_ROUTING_MODE=primary_with_failover   # primary_only | primary_with_failover | split
CARRIER_FAILOVER_ERROR_THRESHOLD=5           # consecutive failures before flip
CARRIER_FAILOVER_COOLDOWN_SECONDS=300        # how long we stay flipped

# LLM model/routing selection - not read by Settings; model ids and per-surface
# provider routing live elsewhere (code defaults / per-org config), only the API keys
# in Part 1 are global env-level settings today.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REALTIME_MODEL=gpt-realtime
# DeepSeek. VERIFIED against GET https://api.deepseek.com/models on 2026-08-26: the
# ONLY callable IDs are the three below. Dated variants are build dates BEHIND these
# aliases, not model IDs - passing one 404s. Never pin a date.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-pro                  # heavy codegen, implementer tier
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash              # cheap classify/summarize/batch
DEEPSEEK_MODEL_VISION=deepseek-v4-flash-vision-exp  # image reading (experimental id)
GROQ_MODEL=
GOOGLE_MODEL=
OPENROUTER_API_KEY=
LLM_VOICE_PROVIDER=openai                 # openai | anthropic | groq | google
LLM_SMS_PROVIDER=anthropic
LLM_CLASSIFIER_PROVIDER=deepseek-flash

# STT/TTS model-selection detail - not read by Settings (STT_PROVIDER/TTS_PROVIDER and
# the API keys in Part 1 are what the app actually reads).
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-US
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
LOCAL_STT_URL=
ELEVENLABS_MODEL=eleven_flash_v2_5        # flash = lowest latency
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
DEEPGRAM_TTS_MODEL=aura-2-thalia-en       # Deepgram Aura reuses DEEPGRAM_API_KEY
RIME_API_KEY=
LOCAL_TTS_URL=

# ------------------------------------------------------------------------------
# AI AGENT BEHAVIOUR TUNING - reserved for the voice/SMS agent phases.
# ------------------------------------------------------------------------------
AI_VOICE_ENABLED=false
AI_SMS_ENABLED=false
VAD_SILENCE_MS=500                        # silence before we consider the turn over
VAD_MIN_SPEECH_MS=120                     # ignore blips shorter than this
BARGE_IN_ENABLED=true
BARGE_IN_ENERGY_THRESHOLD=0.02
MAX_AGENT_TURN_SECONDS=45
MAX_CALL_SECONDS=900
AI_HANDOFF_KEYWORDS=agent,human,representative,manager
AI_MAX_TURNS_BEFORE_HANDOFF=25
AI_RECORD_CALLS=true
AI_ANNOUNCE_RECORDING=true                # required in 2-party-consent states

# ------------------------------------------------------------------------------
# MEDIA TRANSPORT - superseded by the LiveKit media plane (Part 1); kept for the
# non-LiveKit SIP/WS transport path, not currently read by Settings.
# ------------------------------------------------------------------------------
MEDIA_TRANSPORT=ws_stream                 # ws_stream | sip
MEDIA_WS_BIND=0.0.0.0
MEDIA_WS_PORT=8090
MEDIA_WS_PUBLIC_URL=wss://your-domain.example.com/media
MEDIA_SAMPLE_RATE=8000
MEDIA_ENCODING=PCMU
MEDIA_FRAME_MS=20
MEDIA_JITTER_BUFFER_MS=60
SIP_DOMAIN=
SIP_WSS_URL=
SIP_TRUNK_HOST=
SIP_USERNAME=
SIP_PASSWORD=
RTP_PORT_RANGE_START=16384
RTP_PORT_RANGE_END=32768
SOFTPHONE_MODE=provider_webrtc            # provider_webrtc | sip_over_wss

# ------------------------------------------------------------------------------
# OUTBOUND ENGINE - auto-dialer + SMS scheduler + list upload. Per-org runtime
# policy; lives in the DB, not env, once wired up.
# ------------------------------------------------------------------------------
DIALER_ENABLED=false
DIALER_MODE=power                         # preview | power | parallel | predictive
DIALER_LINES_PER_AGENT=1                  # parallel mode: how many lines at once
DIALER_MAX_CONCURRENT_CALLS=20            # global ceiling across all campaigns
DIALER_ABANDON_RATE_TARGET=0.03           # predictive pacing target (TCPA <=3%)
DIALER_RING_TIMEOUT_SECONDS=30
DIALER_WRAP_UP_SECONDS=10                 # after-call work before next dial
DIALER_AMD_ENABLED=true                   # answering machine detection
DIALER_AMD_ACTION=voicemail_drop          # hangup | voicemail_drop | continue
DIALER_RETRY_ATTEMPTS=3
DIALER_RETRY_BACKOFF_HOURS=4,24,72
DIALER_LOCAL_PRESENCE=false               # match caller-ID area code to lead

SMS_SCHEDULER_ENABLED=false
SMS_SEND_RATE_PER_NUMBER_PER_MINUTE=12
SMS_SEND_JITTER_SECONDS=3,17              # random gap between sends, anti-pattern
SMS_DAILY_CAP_PER_NUMBER=500
SMS_WARMUP_ENABLED=true                   # ramp new numbers slowly
SMS_WARMUP_DAY1_CAP=50
SMS_WARMUP_DAILY_INCREASE=50
SMS_STICKY_SENDER=true                    # same number per contact thread
SMS_MAX_RETRIES=2

IMPORT_MAX_FILE_MB=50
IMPORT_MAX_ROWS=250000
IMPORT_DEDUPE_ON=phone                    # phone | phone+name | none
IMPORT_AUTO_SCRUB_DNC=true
IMPORT_AUTO_VALIDATE_NUMBERS=true         # carrier lookup / line-type check
IMPORT_REJECT_LANDLINES=false

# ------------------------------------------------------------------------------
# COMPLIANCE  (TCPA / 10DLC / DNC / recording consent) - per-org policy.
# ------------------------------------------------------------------------------
DEFAULT_TIMEZONE=America/Chicago
QUIET_HOURS_START=08:00                   # local time of the RECIPIENT
QUIET_HOURS_END=20:00
QUIET_HOURS_ENFORCED=true
OPT_OUT_KEYWORDS=STOP,STOPALL,UNSUBSCRIBE,CANCEL,END,QUIT
OPT_IN_KEYWORDS=START,YES,UNSTOP
HELP_KEYWORDS=HELP,INFO
AUTO_REPLY_ON_OPTOUT=true
DNC_SCRUB_ENABLED=false                   # federal DNC scrub on import
TENDLC_BRAND_ID=
TENDLC_CAMPAIGN_ID=
MESSAGE_THROUGHPUT_MPS=10                 # messages/sec ceiling per campaign tier
RECORDING_RETENTION_DAYS=90
TRANSCRIPT_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# OBSERVABILITY & OPS extras - not read by Settings (SENTRY_DSN/SMTP_* in Part 1 are).
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
METRICS_PORT=9100
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_PORT=587
SMTP_FROM=

# ------------------------------------------------------------------------------
# DEPLOY - read by deploy tooling/operators, not by the api container. deploy/deploy.sh
# takes its target as a CLI arg ([user@host]), not from these.
# ------------------------------------------------------------------------------
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_SSH_KEY=
DEPLOY_PATH=/opt/csaas
